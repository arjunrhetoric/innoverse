# Copy to apps/web/.env.local and fill in real values. Never commit secrets.

# GitHub OAuth (callback: http://localhost:3000/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App (repository operations; optional until created)
# See docs/github-app-setup.md. Dormant when unset.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Database (either key works; MONGO_URI takes precedence)
MONGODB_URI=mongodb://127.0.0.1:27017/innoverse

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Token encryption key for secrets at rest (GitHub tokens).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Local development only: allow a startup account without a company email.
# Hard-disabled in production builds.
ALLOW_TEST_STARTUP_BYPASS=false

# Email (Gmail app password) for proposal/certificate notifications
EMAIL=
EMAIL_PASSWORD=

# File uploads (production/Vercel). Get from Vercel Dashboard → Storage → Blob.
# When unset, files are written to local disk (local dev only).
BLOB_READ_WRITE_TOKEN=

# Live updates across serverless instances (production/Vercel).
# Upstash Redis via Vercel Marketplace (REDIS_KV_URL is auto-injected).
# When unset, events use the in-process bus (local dev / single server only).
REDIS_URL=
# KV_URL=
# REDIS_KV_URL=

# Blob access mode: "private" (recommended) or "public".
# Unset = auto-detect from the connected store.
BLOB_ACCESS=
