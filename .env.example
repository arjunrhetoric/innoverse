# Copy to apps/web/.env.local and fill in real values. Never commit secrets.

# GitHub OAuth (callback: http://localhost:3000/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database (either key works; MONGO_URI takes precedence)
MONGODB_URI=mongodb://127.0.0.1:27017/innoverse

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Email (Gmail app password) for proposal/certificate notifications
EMAIL=
EMAIL_PASSWORD=
